# compilers.yaml — Egeon (commented)
# ---------------------------------------------------------------------------
# Purpose:
#   Defines the compiler toolchains available for this HPC site configuration.
#   This file is automatically generated or updated by:
#     spack compiler find --scope site <compiler_prefix>
#
# Context:
#   The compiler below (gcc@12.3.0) is bootstrapped automatically via the
#   installation script `install_and_test_spack_stack.sh`, which builds GCC
#   using the system GCC (9.4.0) only once. After installation, this modern
#   compiler becomes the default for the Spack-Stack environment.
#
# Notes:
#   - Manual edits are rarely necessary; Spack regenerates this file when new
#     compilers are discovered or removed.
#   - The "paths" section is site-specific and will include the unique Spack
#     hash directory generated at install time.
#   - Environment variables (PATH, LD_LIBRARY_PATH, etc.) are managed by Spack
#     and should not be manually added here unless a specific exception applies.
# ---------------------------------------------------------------------------

compilers:
  - compiler:
      # Compiler specification recognized by Spack.
      # The version string matches the one installed during bootstrap.
      spec: gcc@${GCC_VERSION}

      # Absolute paths to each compiler binary.
      # These will point to the Spack installation prefix of gcc@12.3.0,
      # automatically resolved by `spack compiler find`.
      paths:
        cc:  ${STACK_ROOT}/${SPACK_STACK_VERSION}/opt/spack/linux-rhel8-x86_64/gcc-9.4.0/gcc-12.3.0-*/bin/gcc
        cxx: ${STACK_ROOT}/${SPACK_STACK_VERSION}/opt/spack/linux-rhel8-x86_64/gcc-9.4.0/gcc-12.3.0-*/bin/g++
        f77: ${STACK_ROOT}/${SPACK_STACK_VERSION}/opt/spack/linux-rhel8-x86_64/gcc-9.4.0/gcc-12.3.0-*/bin/gfortran
        fc:  ${STACK_ROOT}/${SPACK_STACK_VERSION}/opt/spack/linux-rhel8-x86_64/gcc-9.4.0/gcc-12.3.0-*/bin/gfortran

      # Operating system and target architecture.
      # These values ensure builds are reproducible and portable within the site.
      operating_system: rhel8
      target: x86_64

      # Modules used to load this compiler (empty for Spack-installed toolchains).
      # When the compiler is external (e.g., provided by system modules),
      # module names are listed here. For internal compilers, leave blank.
      modules: []

      # Custom environment variables or path modifications.
      # Normally empty — Spack manages PATH, LD_LIBRARY_PATH, etc. automatically.
      environment: {}

      # Additional compiler flags, if required.
      # These can be used for tuning (e.g., `-march=native`, `-O3`),
      # but defaults are sufficient for Spack-Stack builds.
      flags: {}

      # Extra RPATHs injected during linking.
      # Rarely needed when using Spack-managed compilers; kept for completeness.
      extra_rpaths: []

